# ─────────────────────────────────────────────────────────────
#  Hermes Operator — Variáveis de Ambiente (HF Secrets)
# ─────────────────────────────────────────────────────────────
# Configure estas no Hugging Face Space:
#   Settings → Repository Secrets → Add secret
# ─────────────────────────────────────────────────────────────

# OBRIGATÓRIA: Chave de API do OpenRouter
# Crie uma em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OPCIONAL: Modelo padrão (muda sem rebuild)
# Valores comuns:
#   deepseek/deepseek-chat         (rápido e barato)
#   anthropic/claude-sonnet-4      (excelente para código)
#   openai/gpt-4o                  (versátil)
#   google/gemini-2.0-flash-001    (rápido e gratuito)
#   meta-llama/llama-3.3-70b       (open source)
HERMES_MODEL=deepseek/deepseek-chat

# OPCIONAL: Provider (padrão: openrouter)
# Só mude se for usar outro provider
# HERMES_PROVIDER=openrouter

# RECOMENDADO: Chave para autenticar requests na API
# Sem isso, QUALQUER REQUEST será aceita (só usar em rede confiável)
API_SERVER_KEY=minha-chave-secreta-aqui

# ── Cloudflare Worker Relay (alternativa à bridge local) ─────
# Relay Telegram messages via Cloudflare Worker (free, sem cartão)
# Crie o Worker em https://dash.cloudflare.com/ → Workers & Pages
# Defina o segredo WORKER_API_KEY lá dentro
# Veja telegram-worker.js para o código do Worker
# TELEGRAM_WORKER_URL=https://telegram-relay.seunome.workers.dev
# TELEGRAM_WORKER_KEY=sua-chave-worker-aqui
